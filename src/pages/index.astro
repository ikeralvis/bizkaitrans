---
import AppShell from "../components/AppShell.svelte";
import ThemeToggle from "../components/shared/ThemeToggle.svelte";
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Bizkaitrans</title>
		<script is:inline>
			// Applied before paint to avoid a flash of the wrong theme.
			const stored = localStorage.getItem("bizkaitrans:theme");
			if (stored === "light" || stored === "dark") {
				document.documentElement.setAttribute("data-theme", stored);
			}
		</script>
	</head>
	<body class="min-h-screen bg-background text-text">
		<header class="flex items-center justify-between px-4 py-4">
			<span class="w-9"></span>
			<h1 class="text-lg font-bold tracking-tight">Bizkaitrans</h1>
			<ThemeToggle client:load />
		</header>
		<AppShell client:load />
	</body>
</html>
